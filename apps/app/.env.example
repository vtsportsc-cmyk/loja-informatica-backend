# Apps Next.js (painel CRM) - variaveis de ambiente.
# Copie para apps/app/.env (arquivo gitignored, criado manualmente no deploy).

# URL base do backend do agente (apps/agent) que expoe as APIs do painel.
AGENT_API_URL=http://localhost:3000

# Chave de API usada pelo app para chamar o agente (deve bater com AGENT_API_KEY do agente).
AGENT_API_KEY=dev_agent_key

# Credenciais Basic Auth do painel CRM (rotas /crm e /api/crm).
# Se nao definidas, o middleware retorna 503 (painel desabilitado).
CRM_PANEL_USERNAME=
CRM_PANEL_PASSWORD=
