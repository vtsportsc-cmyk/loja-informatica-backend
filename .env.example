# ===== LLM PROVIDERS =====
# As DUAS chaves obrigatorias para a demo: GROQ_API_KEY (primario) e
# GEMINI_API_KEY (fallback). As demais variaveis usam defaults seguros.
# Groq (primario) - Llama 3.3 70B gratuito: gere a chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=3500

# Google AI Studio (fallback) - Gemini 3.5 Flash gratuito: gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=3500

# ===== ERP =====
ERP_BASE_URL=https://erp.internal/v1
ERP_API_TOKEN=

# ===== EVOLUTION API (atendimento WhatsApp) =====
# Instancia/credenciais da Evolution API v2 (https://doc.evolution-api.com).
# Webhook configurado na Evolution -> POST {AGENT}/webhooks/whatsapp (evento messages.upsert).
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=loja
EVOLUTION_API_KEY=
# Segredo compartilhado para validar o header x-signature dos webhooks (opcional).
EVOLUTION_WEBHOOK_SECRET=

# ===== BANCO (PostgreSQL via Prisma) =====
# Vazio = modo sem banco (repo em memoria) para dev/demo.
# Em producao: postgresql://usuario:senha@host:5432/loja?schema=public
DATABASE_URL=

# ===== API DO PAINEL CRM (apps/app -> apps/agent) =====
# Chave exigida no header x-agent-key das rotas /api/* do agente.
AGENT_API_KEY=dev_agent_key
# Numero do WhatsApp da loja (links wa.me no "Monte seu PC").
STORE_WHATSAPP_NUMBER=5511999990000

# ===== BLING (NF / expedicao) =====
# Disparado quando o funil de CRM chega em AGUARDANDO_NF. Vazio = no-op.
BLING_BASE_URL=https://www.bling.com.br/Api/v3
BLING_ACCESS_TOKEN=

# ===== PAGAMENTOS =====
PAYMENT_BASE_URL=https://gateway.payments/v1
PAYMENT_API_KEY=
# Segredo compartilhado para validar a assinatura HMAC (x-signature) dos webhooks.
PAYMENT_WEBHOOK_SECRET=
PIX_MERCHANT_NAME="Loja de Informatica LTDA"
PIX_MERCHANT_CITY="SAO PAULO"
PIX_MERCHANT_KEY=
PIX_EXPIRES_IN_MINUTES=30

# ===== RATE LIMIT DO ATENDIMENTO =====
# Maximo de mensagens por ticket/cliente dentro da janela (anti-loop de LLM).
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# ===== SESSAO / PERSISTENCIA =====
# memory (padrao) ou redis (exige injetar o cliente Redis na app).
SESSION_STORE=memory
SESSION_TTL_SECONDS=1800
REDIS_URL=redis://localhost:6379

# ===== RAG =====
RAG_INDEX_PATH=./data/knowledge-index.json

# ===== CRM (Backstage / Gestao de Oportunidades) =====
# Envio ASSINCRONO de eventos de ciclo de vida (lead.created, pix.generated,
# pix.expired, sale.completed) para o trycompai/crm. Falha nunca bloqueia o fluxo.
CRM_API_URL=http://localhost:4000/api/v1
CRM_API_TOKEN=crm_dev_token
# true = envia eventos; false = no-op silencioso (recomendado em dev).
CRM_ENABLED=false

# ===== SERVER =====
PORT=3000

# ===== APPS/APP (Next.js) =====
# URL e chave do agente usadas pelo proxy do painel CRM (/api/crm/*).
# AGENT_API_URL=http://localhost:3000
# AGENT_API_KEY=dev_agent_key
# STORE_WHATSAPP_NUMBER=5511999990000
# Credenciais do HTTP Basic Auth do painel CRM (/crm e /api/crm/*).
# Em producao, DEFINA as duas (senha forte). Mudanca exige rebuild do app.
CRM_PANEL_USERNAME=admin
CRM_PANEL_PASSWORD=loja-admin
