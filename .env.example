# ===== LLM PROVIDERS =====
# As DUAS chaves obrigatorias para a demo: GROQ_API_KEY (primario) e
# GEMINI_API_KEY (fallback). As demais variaveis usam defaults seguros.
# Groq (primario) - Llama 3.3 70B gratuito: gere a chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=3500

# Google AI Studio (fallback) - Gemini 3.5 Flash gratuito: gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=3500

# ===== TRANSCRICAO DE AUDIO (speech-to-text) =====
# Audios recebidos no WhatsApp sao transcritos antes do processamento pela IA.
# Primario: Groq Whisper. Fallback: Gemini Audio (usa a MESMA GEMINI_API_KEY).
# GEMINI_AUDIO_BASE_URL e a base NATIVA do Generative Language (nao a OpenAI-compat).
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GEMINI_AUDIO_MODEL=gemini-2.0-flash
GEMINI_AUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AUDIO_TRANSCRIPTION_ENABLED=true

# ===== ERP =====
ERP_BASE_URL=https://erp.internal/v1
ERP_API_TOKEN=

# ===== EVOLUTION API (atendimento WhatsApp) =====
# Instancia/credenciais da Evolution API v2 (https://doc.evolution-api.com).
# Webhook configurado na Evolution -> POST {AGENT}/webhooks/whatsapp (evento messages.upsert).
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=loja
EVOLUTION_API_KEY=
# Segredo compartilhado para validar o header x-signature dos webhooks (opcional).
EVOLUTION_WEBHOOK_SECRET=

# ===== AUTOMACAO DO INSTAGRAM (comentarios -> Direct) =====
# Comentario com palavra-chave (PC/MONTAR/QUERO) no Instagram responde no Direct
# com o link do "Monte seu PC" (?utm_source=instagram_comment) e cria lead
# INSTAGRAM no Kanban do CRM. Requer uma instancia do tipo INSTAGRAM na Evolution
# (EVOLUTION_INSTAGRAM_INSTANCE) ou o webhook da Meta Graph API.
# INSTAGRAM_AUTOMATION_ENABLED=false
# EVOLUTION_INSTAGRAM_INSTANCE=loja-ig
# Segredo para validar x-hub-signature-256 (Meta) / x-signature (Evolution).
# INSTAGRAM_WEBHOOK_SECRET=
# Token de verificacao do webhook do Meta Graph API (hub.verify_token).
# INSTAGRAM_WEBHOOK_TOKEN=loja_verify_token
# URL publica do apps/app (link do Monte seu PC nos DMs).
# APP_PUBLIC_URL=http://localhost:3001

# ===== BANCO (PostgreSQL via Prisma) =====
# Vazio = modo sem banco (repo em memoria) para dev/demo.
# Em producao: postgresql://usuario:senha@host:5432/loja?schema=public
DATABASE_URL=

# ===== API DO PAINEL CRM (apps/app -> apps/agent) =====
# Chave exigida no header x-agent-key das rotas /api/* do agente.
AGENT_API_KEY=dev_agent_key
# Numero do WhatsApp da loja (links wa.me no "Monte seu PC").
STORE_WHATSAPP_NUMBER=5511999990000

# ===== BLING (NF / expedicao) =====
# Disparado quando o funil de CRM chega em AGUARDANDO_NF. Vazio = no-op.
BLING_BASE_URL=https://www.bling.com.br/Api/v3
BLING_ACCESS_TOKEN=

# ===== PAGAMENTOS =====
PAYMENT_BASE_URL=https://gateway.payments/v1
PAYMENT_API_KEY=
# Segredo compartilhado para validar a assinatura HMAC (x-signature) dos webhooks.
PAYMENT_WEBHOOK_SECRET=
PIX_MERCHANT_NAME="Loja de Informatica LTDA"
PIX_MERCHANT_CITY="SAO PAULO"
PIX_MERCHANT_KEY=
PIX_EXPIRES_IN_MINUTES=30

# ===== RATE LIMIT DO ATENDIMENTO =====
# Maximo de mensagens por ticket/cliente dentro da janela (anti-loop de LLM).
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# ===== SESSAO / PERSISTENCIA =====
# memory (padrao) ou redis (exige injetar o cliente Redis na app).
SESSION_STORE=memory
SESSION_TTL_SECONDS=1800
REDIS_URL=redis://localhost:6379

# ===== CACHE DE RESPOSTAS INSTITUCIONAIS (Redis) =====
# true = FAQs frequentes (endereco, horario, pagamento, garantia, entrega) sao
# servidas direto do Redis SEM consumir tokens da LLM. Se o Redis cair, degrada
# para memoria (graceful) e o agente segue funcionando.
REDIS_CACHE_ENABLED=false
# URL do cache (default: usa o REDIS_URL acima).
# REDIS_CACHE_URL=redis://localhost:6379
# TTL do cache institucional em segundos (default 12h).
INSTITUTIONAL_CACHE_TTL_SECONDS=43200

# ===== RAG =====
RAG_INDEX_PATH=./data/knowledge-index.json

# ===== CRM (Backstage / Gestao de Oportunidades) =====
# Envio ASSINCRONO de eventos de ciclo de vida (lead.created, pix.generated,
# pix.expired, sale.completed) para o trycompai/crm. Falha nunca bloqueia o fluxo.
CRM_API_URL=http://localhost:4000/api/v1
CRM_API_TOKEN=crm_dev_token
# true = envia eventos; false = no-op silencioso (recomendado em dev).
CRM_ENABLED=false

# ===== SERVER =====
PORT=3000

# ===== FOLLOW-UP DE ORCAMENTOS INATIVOS =====
# Horas sem contato para o orcamento ALTA_VALOR ser considerado inativo (envia lembrete).
FOLLOWUP_INACTIVITY_HOURS=24
# Intervalo entre varreduras do job de follow-up (em minutos).
FOLLOWUP_INTERVAL_MINUTES=60

# ===== APPS/APP (Next.js) =====
# URL e chave do agente usadas pelo proxy do painel CRM (/api/crm/*).
# AGENT_API_URL=http://localhost:3000
# AGENT_API_KEY=dev_agent_key
# STORE_WHATSAPP_NUMBER=5511999990000
# Credenciais do HTTP Basic Auth do painel CRM (/crm e /api/crm/*).
# Em producao, DEFINA as duas (senha forte). Se nao definidas, o painel retorna 503.
CRM_PANEL_USERNAME=
CRM_PANEL_PASSWORD=

# ===== BANCO DOCKER (db) =====
# Senha do superusuario PostgreSQL usado pelo docker-compose (obrigatoria).
POSTGRES_USER=loja
POSTGRES_PASSWORD=

# ===== N8N (workflows Meta Ads -> CRM) =====
# Segredos do n8n (todos obrigatorios no docker-compose; NAO commitar valores reais).
N8N_PORT=5678
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=
# IP publico da VPS para o webhook do n8n (WEBHOOK_URL) e links wa.me.
PUBLIC_IP=
# Token de Pages do Meta para o workflow de leads (vazio ate configurar).
FB_ACCESS_TOKEN=
